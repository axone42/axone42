# ===== 사이트 =====
# 배포 도메인 (SEO/사이트맵/OG에 사용). 예: https://axone.kr
NEXT_PUBLIC_SITE_URL=https://axone.kr

# ===== Mailgun (문의 폼 메일 발송) =====
# Mailgun 대시보드 > Sending > Domains 에서 확인
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.axone.kr
# EU 리전 계정이면 https://api.eu.mailgun.net 로 변경 (기본: US)
MAILGUN_API_BASE=https://api.mailgun.net

# 발신자(도메인 인증된 주소여야 함)와 수신자
MAIL_FROM=AXONE 문의 <postmaster@mg.axone.kr>
MAIL_TO=ai-consulting@naver.com
