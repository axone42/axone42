# ===== 사이트 =====
# 배포 도메인 (SEO/사이트맵/OG에 사용). 예: https://axone.ai.kr
NEXT_PUBLIC_SITE_URL=https://axone.ai.kr

# ===== 상담 전환 측정 (선택) =====
# Google Analytics 4 > 관리 > 데이터 스트림 > 웹 스트림 > 측정 ID
# 비워두면 외부 분석 서비스로 전송하지 않습니다.
NEXT_PUBLIC_GA_ID=

# ===== 상담 DB (필수, 서버 전용) =====
DATABASE_URL=

# ===== Slack 알림 (채널 Incoming Webhook) =====
SLACK_WEBHOOK_URL=
# 예약 재전송 인증용 무작위 비밀값
CRON_SECRET=

# ===== Gmail 수신 (Apps Script와 동일한 값) =====
GMAIL_MAILBOX=axone042@gmail.com
GMAIL_INGEST_SECRET=

# ===== Mailgun (선택적인 문의 알림, 없어도 DB 접수 가능) =====
# Mailgun 대시보드 > Sending > Domains 에서 확인
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.axone.ai.kr
# EU 리전 계정이면 https://api.eu.mailgun.net 로 변경 (기본: US)
MAILGUN_API_BASE=https://api.mailgun.net

# 발신자(도메인 인증된 주소여야 함)와 수신자
MAIL_FROM=AXONE 문의 <postmaster@mg.axone.ai.kr>
MAIL_TO=axone042@gmail.com

# ===== 관리자 로그인 (/admin) =====
# ADMIN_PASSWORD: 관리자 페이지 로그인 비밀번호 (원하는 값으로 변경)
# ADMIN_TOKEN: 로그인 세션 쿠키에 저장되는 서버 비밀값 (임의의 긴 랜덤 문자열)
ADMIN_PASSWORD=change-this-password
ADMIN_TOKEN=replace-with-a-long-random-string
